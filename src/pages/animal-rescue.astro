---
import { getEntry, render } from "astro:content";
import Markdown from "@components/common/Markdown.astro";
import Comment from "@components/comment/index.astro";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { commentConfig } from "@/config";

const post = await getEntry("welfare", "animal-rescue");

if (!post) {
    throw new Error("Welfare page not found");
}

const { Content } = await render(post);

const isCommentEnabled = commentConfig?.type && commentConfig.type !== "none";
---

<MainGridLayout title={post.data.title} description={post.data.description}>
    <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-9 py-6 relative w-full">
            <Markdown class="mt-2">
                <Content />
            </Markdown>
        </div>
    </div>

<!-- 评论区 -->
    {isCommentEnabled && (
        <div class="mt-4 w-full rounded-(--radius-large) overflow-hidden relative">
            <div class="card-base z-10 px-9 py-6 relative w-full">
                <Comment post={null} customPath="/welfare/animal-rescue/" />
            </div>
        </div>
    )}
</MainGridLayout>
